# PostgreSQL (docker-compose)
POSTGRES_DB=kutuphane_db
POSTGRES_USER=kutuphane
POSTGRES_PASSWORD=kutuphane
# Bilgisayardaki port (5432 yerel bir PostgreSQL ile çakışmasın diye 5433)
POSTGRES_HOST_PORT=5433

# Backend — yerel geliştirmede SQLite yeterli
DATABASE_URL=sqlite:///./kutuphane.db
# Docker dışındaki PostgreSQL için:
# DATABASE_URL=postgresql+psycopg://kutuphane:kutuphane@localhost:5433/kutuphane_db
CORS_ORIGINS=["http://localhost:5173"]

# Frontend dev sunucusunun /api isteklerini yönlendireceği adres
VITE_PROXY_TARGET=http://localhost:8000

# JWT — üretimde mutlaka uzun, rastgele bir değer kullanın
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Günlük görevi (gecikme / rezervasyon / üyelik süreleri) backend içinde her gece 00:05'te çalıştır
RUN_DAILY_JOBS=false
