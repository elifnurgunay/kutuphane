# PostgreSQL (docker-compose)
POSTGRES_DB=kutuphane_db
POSTGRES_USER=kutuphane
POSTGRES_PASSWORD=kutuphane

# Backend — yerel geliştirmede SQLite yeterli
DATABASE_URL=sqlite:///./kutuphane.db
# Docker dışındaki PostgreSQL için:
# DATABASE_URL=postgresql+psycopg://kutuphane:kutuphane@localhost:5432/kutuphane_db
CORS_ORIGINS=["http://localhost:5173"]

# Frontend dev sunucusunun /api isteklerini yönlendireceği adres
VITE_PROXY_TARGET=http://localhost:8000
